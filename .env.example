# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
VERTEX_MODEL=gemini-2.5-flash

# ── Elastic ───────────────────────────────────────────────────────────────────
# Elasticsearch URL — from Kibana → Connection details (starts with .es.)
ELASTIC_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io

# API key — from Kibana → Stack Management → API keys
# REQUIRED Kibana feature privileges (set under "Kibana privileges" when creating the key):
#   - feature_agentBuilder.read
#   - feature_actions.read
# REQUIRED Elasticsearch cluster privileges:
#   - monitor_inference
# REQUIRED index privileges on blueprint_* indices:
#   - read, view_index_metadata, create_index, write
ELASTIC_API_KEY=your_elastic_api_key_here

# Elastic Agent Builder MCP endpoint — uses the KIBANA URL (starts with .kb.)
# Found in Kibana → Agent Builder → Tools → "Connect via MCP"
ELASTIC_MCP_URL=https://your-deployment.kb.us-central1.gcp.cloud.es.io/api/agent_builder/mcp

# ── Slack alerts ──────────────────────────────────────────────────────────────
# Webhook URL: Slack App → Incoming Webhooks → Add New Webhook
# Leave blank to disable alerts entirely
SLACK_WEBHOOK_URL=
# Fire alert when buyer_risk_score >= this value (0 = always, 100 = never effectively)
SLACK_ALERT_THRESHOLD=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://blueprint-XXXXXXXXXX.us-central1.run.app
PORT=8080
